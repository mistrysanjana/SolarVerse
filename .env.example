# SOLARVERSE Environment Variables Example

# Server port
PORT=5000
NODE_ENV=development

# Database connection
# For development SQLite (zero external setup):
DATABASE_URL="file:./dev.db"

# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/solarverse?schema=public"

# NASA API Key (Obtain free at https://api.nasa.gov or keep DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
